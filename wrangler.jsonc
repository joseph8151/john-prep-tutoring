{
  // ─────────────────────────────────────────────────────────────
  // 존프랩튜터링 — Cloudflare 배포 설정
  //
  // ⚠️ 매우 중요: 아래 "name" 은 반드시 다른 사이트(특히 "blossom-books")와
  //    달라야 합니다. Cloudflare 는 이 name 으로 서버(Worker)를 구분하므로,
  //    이름이 같으면 서로의 사이트를 덮어써 버립니다. (과거 충돌 원인)
  //    이 저장소는 오직 "john-prep-tutoring" 서버에만 배포되어야 합니다.
  // ─────────────────────────────────────────────────────────────
  "name": "john-prep-tutoring",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    // 정적 HTML/CSS/JS 를 그대로 서빙합니다. 제외할 파일은 .assetsignore에 정의.
    // src/worker.js가 /api/* 요청만 가로채 처리하고, 나머지는 정적 파일로 서빙합니다.
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
